# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- App metadata ---
APP_NAME=Paisa API
APP_VERSION=0.1.0
ENVIRONMENT=dev

# --- Database (SQLAlchemy async engine, asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://paisa:paisa@localhost:5432/paisa
# Set to true for hosted Postgres (e.g. Neon) - see docs/DEPLOYMENT_GUIDE.md.
DATABASE_SSL_REQUIRED=false

# --- JWT auth ---
JWT_SECRET_KEY=change-me-in-prod
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated list of allowed origins (Expo dev server uses port 8081 locally).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:8099

# --- Local dev port ---
# Run: poetry run uvicorn app.main:app --reload --port 8001

# --- Rate limiting (slowapi, in-memory backend) ---
RATE_LIMIT_DEFAULT=100/minute

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CACHE_DEFAULT_TTL_SECONDS=300

# --- Seed (scripts/seed.py) ---
# There is no public registration endpoint - this is the only way a user
# ever gets created. Set real values before running `python -m scripts.seed`.
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-before-seeding
SEED_USER_NAME=Your Name
